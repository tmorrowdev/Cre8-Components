# --- AI Studio (simplest) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- Vertex AI (GCP service account) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional override (defaults to gemini-3.0-pro)
# GEMINI_MODEL=gemini-2.5-pro

# --- Data Agent ---
# URL of the cre8-data-agent server (defaults to http://localhost:8002)
# NEXT_PUBLIC_DATA_AGENT_URL=http://localhost:8002
# Set API_TOKEN in the agent's env, then mirror it here to enable auth
# NEXT_PUBLIC_DATA_AGENT_TOKEN=
