{
  "name": "@cre8_dev/cre8-wc",
  "version": "1.0.10",
  "description": "cre8 Web Components is a library of presentational UI web components to be consumed by Cre8 web applications.",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "pnpm run build:custom-elements.json && pnpm run storybook",
    "build": "rm -rf lib && vite build && tsc",
    "build:watch": "vite build --watch",
    "build:custom-elements.json": "npx @custom-elements-manifest/analyzer analyze --litelement --globs \"components/*/*.ts\" --outdir .storybook",
    "test": "jest --verbose",
    "test:jenkins": "jest --coverage=false --ci --runInBand --silent --bail",
    "storybook-docs": "storybook dev --docs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "del-cli dist && storybook build -o dist",
    "plop": "plop component",
    "extract-tokens": "node ./extract-tokens.cjs https://mcdonalds.com",
    "convert-scss-to-ts": "npx tsx ./scripts/convert-scss-to-ts.ts",
    "agentrpc": "npx tsx ./cli/agentric-server.ts",
    "generate-theme": "npx tsx ./cli/theme-generator.ts",
    "theme-manager": "npx tsx ./cli/theme-manager.ts",
    "theme-validator": "npx tsx ./cli/theme-validator.ts",
    "plop:page": "plop page",
    "plop:recipe": "plop recipe",
    "lint": "eslint-config --ext .ts,.html . --ignore-path ../../.eslintignore",
    "format": "eslint-config --ext .ts,.html . --fix --ignore-path ../../.eslintignore",
    "release:publish": "node scripts/release.cjs --skip-lint --skip-tests",
    "version:bump": "node scripts/version-bump.cjs"
  },
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "web-components",
    "lit-element",
    "typescript",
    "lit"
  ],
  "author": "",
  "files": [
    "dist",
    "lib",
    ".yalc"
  ],
  "exports": {
    "./components/**/*": {
      "import": "./components/*.js",
      "types": "./components/*.d.ts",
      "default": "./components/*.js"
    },
    "./icons/*": "./icons/*",
    "./svgs/*": "./svgs/*",
    "./index.js": "./index.js"
  },
  "repository": {
    "url": "https://github.com/tmorrowdev/Cre8-Components.git"
  },
  "dependencies": {
    "@a11y/focus-trap": "^1.0.5",
    "@cre8_dev/cre8-design-tokens": "1.0.3",
    "agentrpc": "^0.0.16",
    "chart.js": "^4.5.1",
    "classnames": "2.5.1",
    "lit": "3.3.1",
    "lit-html": "^3.3.1",
    "nanoid": "^5.1.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-typescript": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@skypack/package-check": "^0.2.2",
    "@storybook/addon-a11y": "10.0.6",
    "@storybook/addon-docs": "10.0.6",
    "@storybook/addon-themes": "10.0.6",
    "@storybook/builder-vite": "10.0.6",
    "@storybook/react": "^10.0.6",
    "@storybook/web-components": "^10.0.6",
    "@storybook/web-components-vite": "^10.0.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "babel-jest": "^30.2.0",
    "clone": "^2.1.2",
    "css-parse": "2.0.0",
    "del-cli": "^7.0.0",
    "dotenv": "^17.2.3",
    "element-internals-polyfill": "^3.0.2",
    "fs": "0.0.1-security",
    "glob": "^11.0.3",
    "jest": "^30.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "loader-utils": "^3.3.1",
    "marked": "^17.0.0",
    "node-sass": "9.0.0",
    "openai": "^6.8.1",
    "path": "^0.12.7",
    "plop": "^4.0.4",
    "postcss": "^8.5.6",
    "puppeteer": "^24.29.1",
    "react": "^19.2.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "storybook": "^10.0.6",
    "style-dictionary": "^5.1.1",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.5",
    "ts-lit-plugin": "^2.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  },
  "customElements": ".storybook/custom-elements.json"
}
