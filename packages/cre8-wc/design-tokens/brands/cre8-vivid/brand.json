{
  "$schema": "../../schema/brand.schema.json",
  "name": "cre8-vivid",
  "displayName": "cre8 Vivid",
  "description": "A high-saturation cre8: indigo brand colour paired with cyan, the conventional status mapping (green good, red bad, amber caution) and violet for attention, so no two statuses share a hue.",
  "extends": "cre8",
  "colorScheme": "auto",
  "color": {
    "primary": { "$type": "color", "$value": "#4f46e5", "$description": "Indigo; the brand fill, links and focus." },
    "neutral": { "$type": "color", "$value": "#5b6484", "$description": "Indigo-tinted slate." },
    "accent":  { "$type": "color", "$value": "#7c3aed", "$description": "Violet: visited links and the attention status." },
    "info":    { "$type": "color", "$value": "#4f46e5", "$description": "Info reads as the brand indigo, not the violet accent." },
    "success": { "$type": "color", "$value": "#10b981" },
    "warning": { "$type": "color", "$value": "#f59e0b" },
    "error":   { "$type": "color", "$value": "#e11d48" }
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": "24px" },
    "buttonRadius": { "$type": "dimension", "$value": "900px", "$description": "Pill buttons." }
  },
  "overrides": {
    "--cre8-bg-attention": "var(--cre8-accent-50)",
    "--cre8-bg-attention-strong": "var(--cre8-accent-500)",
    "--cre8-border-attention": "var(--cre8-accent-500)",
    "--cre8-content-attention-icon": "var(--cre8-accent-600)",
    "--cre8-gradient-brand-to": "#06b6d4"
  },
  "accessibility": { "contrastTarget": "AA", "waive": [] }
}
