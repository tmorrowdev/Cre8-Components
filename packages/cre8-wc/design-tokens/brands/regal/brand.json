{
  "$schema": "../../schema/brand.schema.json",
  "$comment": "Regal Bank is a fictional brand used to demonstrate cre8's brand-consumption path. It is not a real financial institution and nothing in the generated UI is a real product offer.",
  "name": "regal",
  "displayName": "Regal Bank",
  "description": "Navy ink on white, square corners, Aeonik. Square corners are the brand's strongest signal: nothing on a Regal surface is rounded.",
  "extends": null,
  "color": {
    "primary": { "$type": "color", "$value": "#132342", "$description": "Ink: buttons, links, brand fills." },
    "neutral": { "$type": "color", "$value": "#979aa0", "$description": "The brand's muted text grey; the guard deepens it where it is used as text." },
    "accent":  { "$type": "color", "$value": "#2a7ab0", "$description": "Sky blue taken from the brand surface (#EDF8FD) at a usable strength." },
    "success": { "$type": "color", "$value": "#3c8700" },
    "error":   { "$type": "color", "$value": "#e4292f" }
  },
  "typography": {
    "body": { "$type": "fontFamily", "$value": ["Aeonik", "sans-serif"] },
    "baseSize": { "$type": "dimension", "$value": "1rem" },
    "fontFaces": [
      { "family": "Aeonik", "src": "../../../assets/fonts/Aeonik-Light.woff2", "weight": 300, "display": "fallback" },
      { "family": "Aeonik", "src": "../../../assets/fonts/Aeonik-Regular.woff2", "weight": 400, "display": "fallback" },
      { "family": "Aeonik", "src": "../../../assets/fonts/Aeonik-Bold.woff2", "weight": 700, "display": "fallback" }
    ]
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": "0px" },
    "buttonRadius": { "$type": "dimension", "$value": "0px" }
  },
  "elevation": { "style": "flat" },
  "accessibility": { "contrastTarget": "AA" },
  "voice": {
    "tone": "plain, unhurried, precise",
    "avoid": ["exclamation marks", "growth-hack phrasing", "invented statistics"]
  }
}
