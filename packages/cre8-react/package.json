{
  "name": "@cre8_dev/cre8-react",
  "version": "1.0.5",
  "description": "The React-powered cre8 design system library for Cigna web applications",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/index.js",
    "./lib/": "./lib/",
    "./lib/components/*": "./lib/components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "pnpm sb dev",
    "build": "npm run lib",
    "lib": "npm run lib.clear && tsc",
    "lib.clear": "del-cli lib",
    "lib.build": "run-p build:js",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "plop": "plop component",
    "plop:page": "plop page",
    "plop:recipe": "plop recipe",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "del-cli dist && pnpm sb build -o dist",
    "lint": "eslint-config ./ --ext tsx,jsx,ts,js --ignore-path ../../.eslintignore",
    "format": "eslint-config ./ --fix --ext tsx,jsx,ts,js --ignore-path ../../.eslintignore"
  },
  "dependencies": {
    "@cre8_dev/cre8-design-tokens": "^1.0.3",
    "@cre8_dev/cre8-wc": "1.0.8",
    "@lit/react": "^1.0.8",
    "classnames": "2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browser": "./lib/index.js",
  "entry": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "lib"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-typescript": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "7.28.5",
    "@etchteam/storybook-addon-css-variables-theme": "^3.0.0",
    "@etchteam/storybook-addon-status": "^8.0.0",
    "@storybook/addon-a11y": "^10.0.6",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^10.0.6",
    "@storybook/addon-storyshots": "^7.6.17",
    "@storybook/cli": "^10.0.6",
    "@storybook/react": "^10.0.6",
    "@storybook/react-vite": "^10.0.6",
    "@storybook/types": "^8.6.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-transform-rename-import": "^2.3.0",
    "css-loader": "7.1.2",
    "del-cli": "^7.0.0",
    "loader-utils": "^3.3.1",
    "npm-run-all": "^4.1.5",
    "plop": "^4.0.4",
    "regenerator-runtime": "0.14.1",
    "sass": "1.93.3",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
