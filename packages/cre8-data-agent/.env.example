# Copy to .env (same directory) and fill in real values:
#
#   cp .env.example .env
#
# This file lives on the HOST. docker-compose.yml reads it for interpolation and
# then hands each variable to the one service that actually reads it — nothing
# here is bulk-mounted into a container. The agent in particular receives none
# of the secrets: it runs with a sentinel key and reaches both upstreams through
# the proxy.

# ---- Secrets: never reach the agent container ----

# Held by the proxy alone. Injected as x-api-key on /llm/* requests.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Shared by the proxy (injects it) and cre8-mcp (validates it). One value, one
# source of truth, so the two can never drift out of sync.
CRE8_MCP_TOKEN=generate-a-strong-random-token-here

# Optional. Only cre8-mcp reads it, for embedding-backed component search.
# Leave blank to fall back to lexical search.
OPENAI_API_KEY=

# ---- Agent settings: not secrets, safe inside the sandbox ----

CLAUDE_MODEL=claude-opus-4-7

# Browser origins allowed to call the agent through the gateway on :8002.
CORS_ORIGINS=http://localhost:3000

# Optional bearer token gating the agent's own inbound API. Blank disables it,
# which is fine while the port is published on loopback only.
API_TOKEN=

# ---- Set by docker-compose.yml, listed for reference ----
# Only override these when running the agent OUTSIDE Docker, where there is no
# proxy and no sandbox.
#   ANTHROPIC_API_KEY=sentinel-not-a-real-key
#   ANTHROPIC_BASE_URL=http://proxy:8080/llm
#   CRE8_MCP_URL=http://proxy:8080/mcp
