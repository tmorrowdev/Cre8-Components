{
  "name": "@tmorrow/cre8-mcp",
  "version": "2.3.6",
  "description": "MCP server providing component intelligence for Cre8 design system (@tmorrow/cre8-wc and @tmorrow/cre8-react)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cre8-mcp": "./dist/index.js",
    "cre8-mcp-api": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npx tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/server.js",
    "dev:api": "npx tsx watch src/server.ts",
    "test": "npx tsx test/surface-api.test.mjs && npx tsx test/stdio-viewer.test.mjs && npx tsx test/a2ui-context.test.mjs && npx tsx test/tenants.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cre8",
    "design-system",
    "web-components",
    "react",
    "ai",
    "claude",
    "anthropic",
    "component-library"
  ],
  "author": "Tyler Morrow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tmorrowdev/Cre8-Components.git",
    "directory": "packages/cre8-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tmorrow/cre8-wc": "workspace:^",
    "@tmorrow/cre8-react": "^2.3.6",
    "hono": "^4.11.4",
    "zod": "^3.23.8",
    "@energetic-ai/embeddings": "^0.2.0",
    "@energetic-ai/model-embeddings-en": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  }
}
