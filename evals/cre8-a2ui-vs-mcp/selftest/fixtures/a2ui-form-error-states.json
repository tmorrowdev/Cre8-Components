{
  "schema": "cre8-a2ui/1.0",
  "root": {
    "component": "cre8-layout-container",
    "children": [
      {
        "component": "cre8-heading",
        "props": {
          "level": 1
        },
        "children": [
          "Create your workspace"
        ]
      },
      {
        "component": "cre8-form",
        "children": [
          {
            "component": "cre8-field",
            "props": {
              "label": "Work email",
              "type": "email",
              "isError": true,
              "errorText": "Enter a work email address - free providers are not supported."
            }
          },
          {
            "component": "cre8-field",
            "props": {
              "label": "Password",
              "type": "password",
              "isSuccess": true,
              "successText": "Strong password."
            }
          },
          {
            "component": "cre8-button",
            "props": {
              "variant": "primary",
              "type": "submit",
              "label": "Create workspace"
            }
          }
        ]
      },
      {
        "component": "cre8-modal",
        "props": {
          "isActive": true,
          "closeButtonText": "Close",
          "utilityModalTitle": "Confirm your email"
        },
        "slots": {
          "default": [
            {
              "component": "cre8-text-passage",
              "children": [
                "We sent a link to dana@innovexa.com."
              ]
            }
          ]
        }
      }
    ]
  }
}
