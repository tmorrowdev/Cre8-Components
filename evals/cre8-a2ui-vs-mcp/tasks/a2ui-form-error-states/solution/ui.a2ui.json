{
  "schema": "cre8-a2ui/1.0",
  "target": "web-components",
  "root": {
    "component": "cre8-layout-container",
    "children": [
      {
        "component": "cre8-heading",
        "props": {
          "tagVariant": "h1",
          "type": "headline-default"
        },
        "children": [
          "Create your workspace"
        ]
      },
      {
        "component": "cre8-form",
        "children": [
          {
            "component": "cre8-field",
            "props": {
              "label": "Work email",
              "type": "email",
              "fieldId": "email",
              "name": "email",
              "isError": true,
              "fieldNote": "Enter a work email address - free providers are not supported.",
              "ariaLive": "polite"
            }
          },
          {
            "component": "cre8-field",
            "props": {
              "label": "Password",
              "type": "password",
              "fieldId": "password",
              "name": "password",
              "isSuccess": true,
              "fieldNote": "Strong password."
            }
          },
          {
            "component": "cre8-button",
            "props": {
              "text": "Create workspace",
              "variant": "primary",
              "type": "submit",
              "size": "lg"
            }
          }
        ]
      },
      {
        "component": "cre8-modal",
        "props": {
          "isActive": true,
          "ariaLabel": "Confirm your email"
        },
        "slots": {
          "header": [
            {
              "component": "cre8-heading",
              "props": {
                "tagVariant": "h2",
                "type": "title-large"
              },
              "children": [
                "Confirm your email"
              ]
            }
          ],
          "default": [
            {
              "component": "cre8-text-passage",
              "children": [
                "We sent a link to dana@innovexa.com."
              ]
            }
          ],
          "footer": [
            {
              "component": "cre8-button",
              "props": {
                "text": "Close",
                "variant": "secondary",
                "size": "lg"
              }
            }
          ]
        }
      }
    ]
  }
}
