{
  "schema": "cre8-a2ui/1.0",
  "target": "web-components",
  "root": {
    "component": "cre8-layout",
    "children": [
      {
        "component": "cre8-main",
        "children": [
          {
            "component": "cre8-layout-container",
            "children": [
              {
                "component": "cre8-heading",
                "props": {
                  "tagVariant": "h1",
                  "type": "headline-large"
                },
                "children": [
                  "Account overview"
                ]
              },
              {
                "component": "cre8-alert",
                "props": {
                  "status": "error",
                  "variant": "banner",
                  "emphasis": "strong",
                  "headerText": "Payment failed"
                },
                "slots": {
                  "default": [
                    {
                      "component": "cre8-text-passage",
                      "children": [
                        "Payment failed - update your card to avoid service interruption"
                      ]
                    }
                  ]
                }
              },
              {
                "component": "cre8-card",
                "slots": {
                  "header": [
                    {
                      "component": "cre8-heading",
                      "props": {
                        "tagVariant": "h2",
                        "type": "title-default"
                      },
                      "children": [
                        "Dana Whitfield"
                      ]
                    }
                  ],
                  "default": [
                    {
                      "component": "cre8-badge",
                      "props": {
                        "text": "DW",
                        "status": "info"
                      }
                    }
                  ]
                }
              },
              {
                "component": "cre8-grid",
                "props": {
                  "variant": "3up",
                  "gap": "lg"
                },
                "children": [
                  {
                    "component": "cre8-grid-item",
                    "children": [
                      {
                        "component": "cre8-card",
                        "slots": {
                          "header": [
                            {
                              "component": "cre8-heading",
                              "props": {
                                "tagVariant": "h3",
                                "type": "label-large"
                              },
                              "children": [
                                "Balance"
                              ]
                            }
                          ],
                          "default": [
                            {
                              "component": "cre8-text-passage",
                              "children": [
                                "$4,280.00"
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "component": "cre8-grid-item",
                    "children": [
                      {
                        "component": "cre8-card",
                        "slots": {
                          "header": [
                            {
                              "component": "cre8-heading",
                              "props": {
                                "tagVariant": "h3",
                                "type": "label-large"
                              },
                              "children": [
                                "Open invoices"
                              ]
                            }
                          ],
                          "default": [
                            {
                              "component": "cre8-text-passage",
                              "children": [
                                "3"
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "component": "cre8-grid-item",
                    "children": [
                      {
                        "component": "cre8-card",
                        "slots": {
                          "header": [
                            {
                              "component": "cre8-heading",
                              "props": {
                                "tagVariant": "h3",
                                "type": "label-large"
                              },
                              "children": [
                                "Next payment"
                              ]
                            }
                          ],
                          "default": [
                            {
                              "component": "cre8-text-passage",
                              "children": [
                                "Mar 14"
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "cre8-section",
                "props": {
                  "headline": "Recent activity"
                },
                "slots": {
                  "default": [
                    {
                      "component": "cre8-list",
                      "props": {
                        "spacing": "condensed"
                      },
                      "children": [
                        {
                          "component": "cre8-list-item",
                          "children": [
                            "Invoice #4471 issued"
                          ]
                        },
                        {
                          "component": "cre8-list-item",
                          "children": [
                            "Card ending 4242 declined"
                          ]
                        },
                        {
                          "component": "cre8-list-item",
                          "children": [
                            "Seat added: r.okafor"
                          ]
                        },
                        {
                          "component": "cre8-list-item",
                          "children": [
                            "Plan changed to Scale"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "component": "cre8-button-group",
                "children": [
                  {
                    "component": "cre8-button",
                    "props": {
                      "text": "Add funds",
                      "variant": "primary",
                      "size": "lg"
                    }
                  },
                  {
                    "component": "cre8-button",
                    "props": {
                      "text": "Download statements",
                      "variant": "tertiary",
                      "size": "lg"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
