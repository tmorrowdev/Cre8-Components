{
  "schema": "cre8-a2ui/1.0",
  "target": "web-components",
  "root": {
    "component": "cre8-layout-container",
    "children": [
      {
        "component": "cre8-alert",
        "props": {
          "status": "warning",
          "variant": "banner",
          "emphasis": "strong",
          "headerText": "Degraded performance"
        },
        "slots": {
          "default": [
            {
              "component": "cre8-text-passage",
              "children": [
                "Write requests are queuing in us-east-1. Reads are unaffected."
              ]
            }
          ]
        }
      },
      {
        "component": "cre8-grid",
        "props": {
          "variant": "3up",
          "gap": "sm"
        },
        "children": [
          {
            "component": "cre8-grid-item",
            "children": [
              {
                "component": "cre8-badge",
                "props": {
                  "text": "Dashboard",
                  "status": "success"
                }
              }
            ]
          },
          {
            "component": "cre8-grid-item",
            "children": [
              {
                "component": "cre8-badge",
                "props": {
                  "text": "API",
                  "status": "warning"
                }
              }
            ]
          },
          {
            "component": "cre8-grid-item",
            "children": [
              {
                "component": "cre8-badge",
                "props": {
                  "text": "Webhooks",
                  "status": "error"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "cre8-button-group",
        "children": [
          {
            "component": "cre8-button",
            "props": {
              "text": "View incident history",
              "variant": "tertiary",
              "size": "sm"
            }
          },
          {
            "component": "cre8-button",
            "props": {
              "text": "Subscribe to updates",
              "variant": "primary",
              "size": "lg"
            }
          }
        ]
      }
    ]
  }
}
