{
  "name": "cre8-web-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wc": "pnpm --filter @tmorrow/cre8-wc build",
    "build:mcp": "pnpm --filter @tmorrow/cre8-mcp build",
    "build": "pnpm build:wc && pnpm build:mcp",
    "build:all": "pnpm --filter @tmorrow/cre8-wc build:custom-elements.json && pnpm build:wc && pnpm --filter @tmorrow/cre8-wc build:a2ui && pnpm build:mcp && pnpm --filter @tmorrow/cre8-wc build-storybook && pnpm --filter @tmorrow/cre8-wc build-storybook:react",
    "release:publish": "pnpm --filter @tmorrow/cre8-wc release:publish",
    "publish:react": "pnpm --filter @tmorrow/cre8-wc publish:react",
    "storybook": "pnpm --filter @tmorrow/cre8-wc storybook",
    "storybook:react": "pnpm --filter @tmorrow/cre8-wc storybook:react",
    "test": "pnpm --filter @tmorrow/cre8-wc test",
    "mcp:api": "pnpm --filter @tmorrow/cre8-mcp dev:api",
    "studio": "pnpm --filter @tmorrow/cre8-studio dev",
    "studio:full": "concurrently -k -n mcp,studio -c magenta,cyan \"pnpm mcp:api\" \"pnpm studio\"",
    "kb:generate": "node docs/kb/tools/generate-reference.mjs",
    "kb:check": "node docs/kb/tools/check-links.mjs && node docs/kb/tools/check-examples.mjs && node docs/kb/tools/check-demo-attrs.mjs && node docs/kb/tools/check-drift.mjs",
    "kb:check-urls": "node docs/kb/tools/check-urls.mjs",
    "kb:check-drift": "node docs/kb/tools/check-drift.mjs",
    "kb:check-demo-attrs": "node docs/kb/tools/check-demo-attrs.mjs",
    "test:mcp": "pnpm --filter @tmorrow/cre8-mcp test",
    "test:agent": "pnpm --filter @tmorrow/cre8-agent-core test",
    "test:custody": "pnpm --filter @tmorrow/cre8-key-custody test",
    "build:agent": "pnpm --filter @tmorrow/cre8-agent-core build",
    "test:a2ui": "pnpm --filter @tmorrow/cre8-wc test:a2ui",
    "audit:render": "pnpm --filter @tmorrow/cre8-wc audit:render",
    "check:parity": "pnpm --filter @tmorrow/cre8-wc check:parity"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.11.0",
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34",
      "sanitize-html": "^2.17.7",
      "postcss": "^8.5.23",
      "fast-uri": "^3.1.6",
      "@xmldom/xmldom": "^0.8.15",
      "next": "^16.2.11",
      "protobufjs": "^7.6.5",
      "ip-address": "^10.3.1",
      "@protobufjs/utf8": "^1.1.1",
      "ws": "^8.21.0",
      "qs": "^6.16.0",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "brace-expansion": "^5.0.9",
      "esbuild": "^0.28.1",
      "vite": "^7.3.5",
      "js-yaml": "^4.3.1",
      "@babel/core": "^7.29.6",
      "tar@<7.5.21": ">=7.5.21",
      "@vitest/browser@4": ">=4.1.10",
      "shell-quote": ">=1.9.0",
      "immutable@5": ">=5.1.8",
      "sharp@<0.35.0": ">=0.35.0",
      "style-dictionary@5": ">=5.4.4",
      "nanoid@3": ">=3.3.18",
      "nanoid@>=4 <6": ">=5.1.16",
      "browserslist@4": ">=4.28.7",
      "@hono/node-server@1": ">=1.19.15",
      "valibot@1": ">=1.4.2",
      "decode-uri-component@<0.5.0": ">=0.5.0",
      "@humanfs/node@0.16": ">=0.16.8",
      "body-parser@2": ">=2.3.0"
    }
  }
}
